# Copia este archivo como .env y cambia los valores. El .env NUNCA se sube al repositorio.

# Usuario y contraseña para entrar a la plataforma (contraseña: mínimo 8 caracteres)
AUTH_USERNAME=alumno
AUTH_PASSWORD=cambia-esta-contrasena

# Clave para firmar la cookie de sesión: mínimo 32 caracteres aleatorios.
# Genera una con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
