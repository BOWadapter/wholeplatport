# Copia este archivo como .env y cambia los valores. El .env NUNCA se sube al repositorio.

# Usuario y contraseña para entrar a la plataforma (contraseña: mínimo 8 caracteres)
AUTH_USERNAME=alumno
AUTH_PASSWORD=cambia-esta-contrasena

# Clave para firmar la cookie de sesión: mínimo 32 caracteres aleatorios.
# Genera una con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Contraseña de PostgreSQL (servicio "db" de compose.yaml). Usa solo letras y números (va dentro de una URL).
# Genera una con:  node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
POSTGRES_PASSWORD=

# Solo para correr la app o las pruebas FUERA de Docker contra el Postgres de Compose (pnpm dev / pnpm test).
# Dentro de Docker, compose.yaml arma DATABASE_URL solo. Sin DATABASE_URL la app funciona sin guardar corridas.
# DATABASE_URL=postgres://wpl:TU_POSTGRES_PASSWORD@127.0.0.1:5432/wpl

# Puerto local de Postgres (solo si 5432 ya está ocupado en tu máquina)
# DB_PORT=5433
